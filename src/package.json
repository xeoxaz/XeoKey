{
  "name": "xeokey-server",
  "version": "1.0.0",
  "description": "A secure, self-hosted password manager built with Bun and MongoDB. Features password encryption, analytics tracking, and a modern web interface.",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "../scripts/bun-runtime.sh run --watch server.ts",
    "start": "../scripts/bun-runtime.sh run server.ts",
    "host": "../scripts/bun-runtime.sh run host.ts",
    "typecheck": "../scripts/bun-runtime.sh x tsc --noEmit",
    "test": "../scripts/bun-runtime.sh test",
    "test:unit": "../scripts/bun-runtime.sh test tests/unit",
    "test:integration": "../scripts/bun-runtime.sh test tests/integration",
    "test:watch": "../scripts/bun-runtime.sh test --watch",
    "test:coverage": "../scripts/bun-runtime.sh test --coverage"
  },
  "keywords": [
    "password-manager",
    "security",
    "bun",
    "mongodb",
    "self-hosted",
    "typescript",
    "encryption",
    "authentication",
    "web-application",
    "analytics"
  ],
  "author": "xeoxaz",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/xeoxaz/XeoKey.git"
  },
  "bugs": {
    "url": "https://github.com/xeoxaz/XeoKey/issues"
  },
  "homepage": "https://github.com/xeoxaz/XeoKey#readme",
  "engines": {
    "bun": ">=1.3.4"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "mongodb": "^7.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.0.2",
    "typescript": "^5.9.3"
  }
}
